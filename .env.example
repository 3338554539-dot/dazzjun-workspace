# Local API
DAZZJUN_API_PORT=8788
DAZZJUN_DATABASE_PATH=.data/dazzjun.sqlite
DAZZJUN_API_PROXY_TARGET=http://127.0.0.1:8788

# Optional local AI provider. Never expose this value through VITE_* variables.
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/chat/completions

# Optional local overrides. Production uses the same names as Worker vars.
AUTH_LOGIN_IP_FAILURES=10
AUTH_LOGIN_ACCOUNT_FAILURES=8
AUTH_REGISTER_IP_REQUESTS=5
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=100

# Production worker binding
# Bind a D1 database as DB before publishing. Configure DEEPSEEK_API_KEY with
# `wrangler secret put DEEPSEEK_API_KEY`; never commit its real value.
